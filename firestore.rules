rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // ===============================================================
    // SHARED SCHOOL DATABASE (Real-time live for all devices & networks)
    // ===============================================================
    match /schools/{schoolId} {
      allow read, write: if isValidId(schoolId);

      match /{allChildren=**} {
        allow read, write: if isValidId(schoolId);
      }
    }

    // ===============================================================
    // USER SPECIFIC DATA
    // ===============================================================
    match /users/{userId} {
      allow read, write: if isValidId(userId);

      match /{allChildren=**} {
        allow read, write: if isValidId(userId);
      }
    }

    // Test doc for connection health check
    match /test/{docId} {
      allow read, write: if true;
    }

    // Fallback for any other documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
