rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // ===============================================================
    // SHARED SCHOOL DATABASE (Real-time live for all devices & networks)
    // ===============================================================
    match /schools/{schoolId} {
      allow read, write: if isValidId(schoolId);

      // School Profile & Settings
      match /schoolData/{docId} {
        allow read, write: if isValidId(docId);
      }

      // Classes
      match /classes/{classId} {
        allow read, write: if isValidId(classId);
      }

      // Students
      match /students/{studentId} {
        allow read, write: if isValidId(studentId);
      }

      // Teachers
      match /teachers/{teacherId} {
        allow read, write: if isValidId(teacherId);
      }

      // Teaching Journals
      match /journals/{journalId} {
        allow read, write: if isValidId(journalId);
      }

      // Attendance Records
      match /attendances/{attendanceId} {
        allow read, write: if isValidId(attendanceId);
      }

      // Assessment Items & Scores
      match /assessments/{assessmentId} {
        allow read, write: if isValidId(assessmentId);
      }
    }

    // ===============================================================
    // USER SPECIFIC DATA
    // ===============================================================
    match /users/{userId} {
      allow read, write: if isValidId(userId);

      match /{allChildren=**} {
        allow read, write: if isValidId(userId);
      }
    }

    // Test doc for connection health check
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}


