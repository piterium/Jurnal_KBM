rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny All Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // ===============================================================
    // SHARED SCHOOL DATABASE (Real-time live for all devices & networks)
    // ===============================================================
    match /schools/{schoolId} {
      allow read, write: if isValidId(schoolId);

      // School Profile & Settings
      match /schoolData/{docId} {
        allow read, write: if isValidId(docId);
      }

      // Classes
      match /classes/{classId} {
        allow read, write: if isValidId(classId);
      }

      // Students
      match /students/{studentId} {
        allow read, write: if isValidId(studentId);
      }

      // Teachers
      match /teachers/{teacherId} {
        allow read, write: if isValidId(teacherId);
      }

      // Teaching Journals
      match /journals/{journalId} {
        allow read, write: if isValidId(journalId);
      }

      // Attendance Records
      match /attendances/{attendanceId} {
        allow read, write: if isValidId(attendanceId);
      }

      // Assessment Items & Scores
      match /assessments/{assessmentId} {
        allow read, write: if isValidId(assessmentId);
      }
    }

    // ===============================================================
    // USER SPECIFIC DATA
    // ===============================================================
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update: if isOwner(userId)
        && isValidId(userId);
      allow delete: if isOwner(userId);

      // School Profile Settings
      match /schoolData/{docId} {
        allow read, write: if isOwner(userId) && isValidId(docId);
      }

      // Classrooms
      match /classes/{classId} {
        allow read, write: if isOwner(userId) && isValidId(classId);
      }

      // Students
      match /students/{studentId} {
        allow read, write: if isOwner(userId) && isValidId(studentId);
      }

      // Teachers
      match /teachers/{teacherId} {
        allow read, write: if isOwner(userId) && isValidId(teacherId);
      }

      // Teaching Journals
      match /journals/{journalId} {
        allow read, write: if isOwner(userId) && isValidId(journalId);
      }

      // Attendance Records
      match /attendances/{attendanceId} {
        allow read, write: if isOwner(userId) && isValidId(attendanceId);
      }

      // Assessment Items & Scores
      match /assessments/{assessmentId} {
        allow read, write: if isOwner(userId) && isValidId(assessmentId);
      }
    }
  }
}

